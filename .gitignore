# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Project: do not version-control bulky raw media or generated artifacts ---
# User-supplied audio (primary) + any media variants
audio/**/*.mp3
audio/**/*.wav
audio/**/*.flac
audio/**/*.ogg
audio/**/*.opus
audio/**/*.m4a
audio/**/*.aac
audio/**/*.mp4
audio/**/*.mkv
audio/**/*.webm
audio/**/*.mov
audio/**/*.avi

# Generated audio chunks and features
data/raw/**/*.wav
data/chunks/**/*.wav
data/features/**/*.npz

# Trained models (regenerate from data)
models/*.pkl
models/*.joblib
models/*.json

# Evaluation reports
reports/*.png
reports/*.html
reports/*.csv
reports/*.md
!reports/.gitkeep

# Streamlit cache
.streamlit/secrets.toml

# --- LaTeX build artefacts (keep the .tex and .pdf, drop the rest) ---
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/*.lof
docs/*.lot
docs/*.fls
docs/*.fdb_latexmk
docs/*.synctex.gz

# Keep folder structure
!.gitkeep
